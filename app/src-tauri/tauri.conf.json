{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "G-vis",
  "version": "1.0.0",
  "identifier": "se.gvis.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "G-vis",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "G-vis",
    "shortDescription": "G-code visualizer, lexicon and CNC simulators",
    "longDescription": "G-vis shows what a CNC program does: toolpath, 3D material removal, physics, courses, a tool and G-code lexicon and simulators for a mill and lathes. Works offline.",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}